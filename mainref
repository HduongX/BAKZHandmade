local function addLog(msg, tag)
    tag = tag or "BUY"
    local timestamp = "00:00:00"
    pcall(function()
        if os and os.date then
            timestamp = os.date("%H:%M:%S")
        end
    end)
    local entry = string.format("[%s] [%s] %s", timestamp, tag, tostring(msg))
    table.insert(logs, entry)
