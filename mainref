-- CONFIG FILE SYSTEM
local CONFIG_FILE = "dev_g_config.json"

local function saveConfig()
    pcall(function()
        if writefile then
            local blackList = {}
            for item, active in pairs(selectedBlacklistItems) do
                if active then table.insert(blackList, item) end
            end
            local data = {
                driveOn = driveOn,
                noclipOn = noclipOn,
                rollBuyOn = rollBuyOn,
                bossOn = bossOn,
                moneyFarmOn = moneyFarmOn,
                customSpeed = customSpeed,
                minRarityIdx = minRarityIdx,
                useBlacklist = useBlacklist,
                blacklistText = blacklistText,
                selectedBlacklistItems = blackList,
                minimizeKeybind = minimizeKeybind and minimizeKeybind.Name or "RightControl"
            }
            writefile(CONFIG_FILE, HttpService:JSONEncode(data))
        end
    end)
end

local function loadConfig()
    pcall(function()
        if readfile and (isfile and isfile(CONFIG_FILE)) then
            local content = readfile(CONFIG_FILE)
            if content and content ~= "" then
                local data = HttpService:JSONDecode(content)
                if data then
                    if type(data.driveOn) == "boolean" then driveOn = data.driveOn end
                    if type(data.noclipOn) == "boolean" then noclipOn = data.noclipOn end
                    if type(data.rollBuyOn) == "boolean" then
                        rollBuyOn = data.rollBuyOn
                        rollOn = rollBuyOn
                        autoBuyOn = rollBuyOn
                    end
                    if type(data.bossOn) == "boolean" then bossOn = data.bossOn end
                    if type(data.moneyFarmOn) == "boolean" then moneyFarmOn = data.moneyFarmOn end
                    if type(data.customSpeed) == "number" then customSpeed = data.customSpeed end
                    if type(data.minRarityIdx) == "number" then minRarityIdx = math.clamp(data.minRarityIdx, 1, #rarityNames) end
                    if type(data.useBlacklist) == "boolean" then useBlacklist = data.useBlacklist end
                    if type(data.blacklistText) == "string" then blacklistText = data.blacklistText end
                    if type(data.selectedBlacklistItems) == "table" then
                        selectedBlacklistItems = {}
                        for _, item in ipairs(data.selectedBlacklistItems) do
                            selectedBlacklistItems[string.lower(tostring(item))] = true
                        end
                    end
                    if type(data.minimizeKeybind) == "string" and Enum.KeyCode[data.minimizeKeybind] then
                        minimizeKeybind = Enum.KeyCode[data.minimizeKeybind]
                    end
                end
            end
        end
    end)
end

