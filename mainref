-- ===================== ENGINE: AUTO-BUY (FAIL-PROOF PROMPT TRIGGERING) =====================
local lastBuyStandState = {}

local function firePromptSafe(prompt)
    if not prompt or not prompt.Parent then return false end

    pcall(function()
        prompt.MaxActivationDistance = math.huge
        prompt.RequiresLineOfSight = false
        prompt.Enabled = true
    end)

    local success = false

    if fireproximityprompt then
        pcall(function()
            fireproximityprompt(prompt)
            success = true
        end)
    end

    pcall(function()
        local hrp = lp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        local promptPart = prompt.Parent
        local targetCFrame = nil

        if promptPart:IsA("BasePart") then
            targetCFrame = promptPart.CFrame
        elseif promptPart:IsA("Attachment") then
            targetCFrame = promptPart.WorldCFrame
        end

        if hrp and targetCFrame then
            hrp.CFrame = targetCFrame
            task.wait(0.08)
        end

        prompt:InputHoldBegin()
        task.wait(0.2)
        prompt:InputHoldEnd()
        success = true
    end)

    return success
end

task.spawn(function()
    while gui and gui.Parent do
        task.wait(0.2)
        if not autoBuyOn then
            lastBuyStandState = {}
        else
            pcall(function()
                local plot = myPlot()
                local rolls = plot and plot:FindFirstChild("Rolls")
                if rolls then
                    for _, standName in ipairs({"RollWeapons", "RollBlocks"}) do
                        local stand = rolls:FindFirstChild(standName)
                        if stand then
                            local buyPrompt = nil
                            for _, desc in ipairs(stand:GetDescendants()) do
                                if desc:IsA("ProximityPrompt") then
                                    local action = string.lower(desc.ActionText or "")
                                    local name = string.lower(desc.Name)
                                    if string.find(action, "buy") or string.find(name, "buy") or string.find(action, "purchase") then
                                        buyPrompt = desc
                                        break
                                    end
                                end
                            end
                            if buyPrompt then
                                local itemName = buyPrompt.ObjectText or ""
                                if itemName ~= "" and itemName ~= "???" then
                                    local stateKey = tostring(buyPrompt:GetDebugId(10)) .. "_" .. itemName
                                    if lastBuyStandState[standName] ~= stateKey then
                                        lastBuyStandState[standName] = stateKey
                                        local rIdx, rName = nil, nil
                                        pcall(function()
                                            for _, desc in ipairs(stand:GetDescendants()) do
                                                if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Text ~= "???"
                                                   and desc.Name ~= "Chance" and desc.Name ~= "Price" and desc.Name ~= "Count" then
                                                    local txt = string.lower(desc.Text)
                                                    for i, rn in ipairs(rarityNames) do
                                                        if string.find(txt, string.lower(rn)) then
                                                            rIdx, rName = i, rn
                                                            break
                                                        end
                                                    end
                                                    if rIdx then break end
                                                end
                                            end
                                        end)
                                        if not rIdx then rIdx, rName = detectRarityInItemPlace() end

                                        -- Check Blacklist system first
                                        local isBlacklisted = false
                                        if useBlacklist then
                                            local itemLow = string.lower(itemName)
                                            for blWord, active in pairs(selectedBlacklistItems) do
                                                if active and string.find(itemLow, blWord) then
                                                    isBlacklisted = true
                                                    break
                                                end
                                            end
                                        end

                                        -- Purchase Decision based on Rarity Filter and Blacklist
                                        local shouldBuy = not isBlacklisted and (rIdx and rIdx >= minRarityIdx)

                                        if shouldBuy then
                                            _G.rollPauseUntil = tick() + 6.0

                                            local hrp = lp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                                            local oldCFrame = hrp and hrp.CFrame

                                            local purchased = false
                                            for attempt = 1, 3 do
                                                if firePromptSafe(buyPrompt) then
                                                    purchased = true
                                                end
                                                task.wait(0.2)
                                            end

                                            if hrp and oldCFrame then
                                                task.wait(0.2)
                                                hrp.CFrame = oldCFrame
                                            end

                                            buyN = buyN + 1
                                            local logMsg = itemName .. " (" .. (rName or "Unknown") .. ")"
                                            addLog(logMsg, "BOUGHT")
                                            notify("BOUGHT: " .. logMsg, false)
                                        else
                                            notify("SKIP: " .. itemName .. " (" .. (rName or "?") .. ")", true)
                                        end
                                    end
                                else
                                    lastBuyStandState[standName] = nil
                                end
                            else
                                lastBuyStandState[standName] = nil
                            end
                        end
                    end
                end
            end)
        end
    end
end)

