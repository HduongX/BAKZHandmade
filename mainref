local function notify(text, isWarning)
    task.spawn(function()
        if not gui or not gui.Parent then return end

        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, 42)
        card.BackgroundColor3 = isWarning and Color3.fromRGB(35, 25, 15) or C.card
        card.BorderSizePixel = 0
        card.ClipsDescendants = true
        card.Parent = notifyContainer
        safeCorner(card, 6)
        safeStroke(card, isWarning and C.orange or C.border, 1, 0.4)

        local accentBar = Instance.new("Frame")
        accentBar.Size = UDim2.new(0, 4, 1, 0)
        accentBar.BackgroundColor3 = isWarning and C.orange or C.accent
        accentBar.BorderSizePixel = 0
        accentBar.Parent = card

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -16, 1, 0)
        label.Position = UDim2.new(0, 12, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = isWarning and Color3.fromRGB(255, 200, 120) or C.textMain
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 13
        label.TextWrapped = true
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = card

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, 0, 0, 3)
        bar.Position = UDim2.new(0, 0, 1, -3)
        bar.BackgroundColor3 = isWarning and C.orange or C.accentLt
        bar.BorderSizePixel = 0
        bar.Parent = card

        safeTween(bar, TweenInfo and TweenInfo.new(3.0, Enum.EasingStyle.Linear) or nil, {Size = UDim2.new(0, 0, 0, 3)})
        task.wait(3.0)
        safeTween(card, TweenInfo and TweenInfo.new(0.3) or nil, {BackgroundTransparency = 1})
        safeTween(label, TweenInfo and TweenInfo.new(0.3) or nil, {TextTransparency = 1})
        task.wait(0.35)
        pcall(function() card:Destroy() end)
    end)
end

