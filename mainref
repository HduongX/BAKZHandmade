local function addToggleRow(parent, labelText, defaultState, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.BackgroundColor3 = C.card
    frame.BorderSizePixel = 0
    frame.Parent = parent
    safeCorner(frame, 5)
    safeStroke(frame, C.border, 1, 0.4)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -70, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = C.textMain
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local pillBg = Instance.new("TextButton")
    pillBg.Size = UDim2.new(0, 42, 0, 22)
    pillBg.Position = UDim2.new(1, -54, 0.5, -11)
    pillBg.BackgroundColor3 = C.border
    pillBg.Text = ""
    pillBg.BorderSizePixel = 0
    pillBg.Parent = frame
    safeCorner(pillBg, 11)

    local pillDot = Instance.new("Frame")
    pillDot.Size = UDim2.new(0, 16, 0, 16)
    pillDot.Position = UDim2.new(0, 3, 0.5, -8)
    pillDot.BackgroundColor3 = Color3.new(1, 1, 1)
    pillDot.BorderSizePixel = 0
    pillDot.Parent = pillBg
    safeCorner(pillDot, 8)

    local state = defaultState or false

    local function updateVisual()
        if state then
            pillBg.BackgroundColor3 = C.accent
            pillDot.Position = UDim2.new(1, -19, 0.5, -8)
            frame.BackgroundColor3 = Color3.fromRGB(24, 20, 36)
        else
            pillBg.BackgroundColor3 = C.border
            pillDot.Position = UDim2.new(0, 3, 0.5, -8)
            frame.BackgroundColor3 = C.card
        end
    end

    local function toggle()
        state = not state
        updateVisual()
        if callback then callback(state) end
        saveConfig()
        return state
    end

    pillBg.MouseButton1Click:Connect(toggle)
    updateVisual()

    return {
        getState = function() return state end,
        setState = function(v) state = v; updateVisual() end,
        toggle = toggle
    }
end

