table.insert(connections, RunService.PostSimulation:Connect(function(dt)
    dt = dt or (1/60)

    pcall(function()
        if bossOn then
            if not currentBoss or not currentBoss.Parent or (currentBoss:FindFirstChild("Humanoid") and currentBoss.Humanoid.Health <= 0) then
                currentBoss = nil
                bossAutoDisabledDrive = false -- reset flag when boss dies/despawns
                
                -- Broad search across ClientBosses, BossFightMap, and Workspace
                local searchContainers = {
                    workspace:FindFirstChild("ClientBosses"),
                    workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("BossFightMap"),
                    workspace:FindFirstChild("BossFightMap"),
                    workspace
                }

                for _, container in ipairs(searchContainers) do
                    if container then
                        for _, obj in ipairs(container:GetDescendants()) do
                            if obj:IsA("Model") and (obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart) then
                                if not Players:GetPlayerFromCharacter(obj) then
                                    local name = string.lower(obj.Name)
                                    local hum = obj:FindFirstChild("Humanoid")
                                    if string.find(name, "hacker") or string.find(name, "zeus") or string.find(name, "boss") or string.find(name, "legenda") or (hum and hum.MaxHealth > 300) then
                                        currentBoss = obj
                                        break
                                    end
                                end
                            end
                        end
                    end
                    if currentBoss then break end
                end
            end

            -- Auto-disable drive & noclip when boss is found (once per encounter)
            if currentBoss and not bossAutoDisabledDrive then
                bossAutoDisabledDrive = true
                if driveOn or noclipOn then
                    driveOn = false
                    noclipOn = false
                    straightDir = nil
                    pcall(function()
                        if ovDrive then ovDrive.setState(false) end
                        if ovNoclip then ovNoclip.setState(false) end
                        if driveMainToggle then driveMainToggle.setState(false) end
                        if noclipMainToggle then noclipMainToggle.setState(false) end
                    end)
                    notify("Boss detected — Auto Drive & Noclip disabled", true)
                    saveConfig()
                end
            end

            -- Determine target root part or position in boss arena
            local targetCFrame = nil
            if currentBoss then
                local root = currentBoss:FindFirstChild("HumanoidRootPart") or currentBoss.PrimaryPart or currentBoss:FindFirstChild("Torso")
                if root then targetCFrame = root.CFrame end
            end

            -- Fallback: if in BossFightMap but model not found yet, use arena center position
            if not targetCFrame then
                local arena = (workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("BossFightMap")) or workspace:FindFirstChild("BossFightMap")
                if arena then
                    local centerPart = arena:FindFirstChild("Center") or arena:FindFirstChild("Spawn") or arena.PrimaryPart
                    if centerPart then
                        targetCFrame = centerPart.CFrame
                    else
                        -- Fallback to character position in arena
                        for _, p in ipairs(arena:GetDescendants()) do
                            if p:IsA("BasePart") then
                                targetCFrame = p.CFrame
                                break
                            end
                        end
                    end
                end
            end

            if targetCFrame then
                local bossPos = targetCFrame.Position
                local car = getCar()
                
                applyNoclip()
                applyIgnoreZombies()

                orbitAngle = orbitAngle + (2.5 * dt)
                local radius = 28
                local offsetX = math.cos(orbitAngle) * radius
                local offsetZ = math.sin(orbitAngle) * radius
                local targetPos = bossPos + Vector3.new(offsetX, 0, offsetZ)

                if car and car.PrimaryPart then
                    local pp = car.PrimaryPart
                    local tangentDir = Vector3.new(-math.sin(orbitAngle), 0, math.cos(orbitAngle)).Unit
                    
                    local rp = RaycastParams.new()
                    rp.FilterType = Enum.RaycastFilterType.Exclude
                    if lp and lp.Character then
                        rp.FilterDescendantsInstances = {car, lp.Character}
                    else
                        rp.FilterDescendantsInstances = {car}
                    end

                    local gRay = workspace:Raycast(pp.Position + Vector3.new(0, 20, 0), Vector3.new(0, -50, 0), rp)
                    local groundY = gRay and (gRay.Position.Y + 3.5) or bossPos.Y

                    pp.AssemblyAngularVelocity = Vector3.zero
                    pp.CFrame = CFrame.lookAt(Vector3.new(targetPos.X, groundY, targetPos.Z), Vector3.new(targetPos.X, groundY, targetPos.Z) + tangentDir)
                    
                    local SPEED = math.clamp(customSpeed, 80, 220)
                    pp.AssemblyLinearVelocity = tangentDir * SPEED
                    return
                elseif lp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                    local myRoot = lp.Character.HumanoidRootPart
                    myRoot.CFrame = CFrame.lookAt(targetPos + Vector3.new(0, 5, 0), bossPos)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    return
                end
            end
            -- No boss target found yet: fall through to normal drive/noclip logic below
        else
            currentBoss = nil
            bossAutoDisabledDrive = false
        end

        -- ===== MONEY FARM ENGINE =====
        if moneyFarmOn then
            applyNoclip()
            applyIgnoreZombies()

            -- Find target position: workspace.Game.Stages.Stage_5.Geometry.Batch_58.Part
            local targetPos = nil
            pcall(function()
                local stages = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Stages")
                if not stages then return end

                local function getPartCenter(inst)
                    if not inst then return nil end
                    if inst:IsA("BasePart") then
                        return inst.Position
                    elseif inst:IsA("Model") then
                        if inst.PrimaryPart then
                            return inst.PrimaryPart.Position
                        else
                            local cf, _ = inst:GetBoundingBox()
                            return cf.Position
                        end
                    end
                    return nil
                end

                -- Check Stage_5 specifically first
                local stage5 = stages:FindFirstChild("Stage_5")
                if stage5 then
                    local geo = stage5:FindFirstChild("Geometry")
                    if geo then
                        local b = geo:FindFirstChild("Batch_58") or geo:FindFirstChild("Batch_57")
                        if b then
                            local p = b:FindFirstChild("Part")
                            if p then
                                targetPos = getPartCenter(p)
                                return
                            end
                            targetPos = getPartCenter(b)
                            return
                        end
                    end
                end

                -- Fallback check for Stage_5 in case of name format variation
                for _, st in ipairs(stages:GetChildren()) do
                    if st.Name == "Stage_5" or st.Name:find("5") then
                        local geo = st:FindFirstChild("Geometry")
                        if geo then
                            local b = geo:FindFirstChild("Batch_58")
                            if b then
                                local p = b:FindFirstChild("Part")
                                targetPos = getPartCenter(p or b)
                                if targetPos then return end
                            end
                        end
                    end
                end
            end)

            if targetPos then
                local car = getCar()
                if car and car.PrimaryPart then
                    local pp = car.PrimaryPart
                    local dist = (Vector3.new(pp.Position.X, 0, pp.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude

                    if dist < 20 or moneyFarmArrived then
                        -- Arrived — freeze car in the middle of Part
                        moneyFarmArrived = true
                        pp.AssemblyLinearVelocity = Vector3.zero
                        pp.AssemblyAngularVelocity = Vector3.zero
                        pp.CFrame = CFrame.new(targetPos.X, targetPos.Y + 2, targetPos.Z) * CFrame.Angles(0, pp.CFrame:ToEulerAnglesYXZ())
                        return
                    else
                        -- Stage_5 target found: drive directly into the middle of Part
                        local dir = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(pp.Position.X, 0, pp.Position.Z)).Unit
                        local SPEED = math.clamp(customSpeed, 100, 300)
                        pp.AssemblyAngularVelocity = Vector3.zero
                        pp.CFrame = CFrame.lookAt(pp.Position, pp.Position + dir)

                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        if lp and lp.Character then
                            rp.FilterDescendantsInstances = {car, lp.Character}
                        else
                            rp.FilterDescendantsInstances = {car}
                        end
                        local gRay = workspace:Raycast(pp.Position + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), rp)
                        local groundY = gRay and (gRay.Position.Y + 2) or pp.Position.Y
                        local yVel = math.clamp((groundY - pp.Position.Y) * 3, -40, 30)

                        pp.AssemblyLinearVelocity = Vector3.new(dir.X * SPEED, yVel, dir.Z * SPEED)
                        return
                    end
                end
            else
                -- Stage_5 has not streamed into workspace yet! Auto drive straight with noclip until it appears
                local car = getCar()
                if car and car.PrimaryPart then
                    local pp = car.PrimaryPart
                    local pos = pp.Position
                    local SPEED = math.clamp(customSpeed, 100, 300)

                    if not straightDir then
                        local look = pp.CFrame.LookVector
                        local hLook = Vector3.new(look.X, 0, look.Z)
                        straightDir = hLook.Magnitude > 0.01 and hLook.Unit or Vector3.new(0, 0, -1)
                    end

                    pp.AssemblyAngularVelocity = Vector3.zero
                    pp.CFrame = CFrame.lookAt(pos, pos + straightDir)

                    local rp = RaycastParams.new()
                    rp.FilterType = Enum.RaycastFilterType.Exclude
                    if lp and lp.Character then
                        rp.FilterDescendantsInstances = {car, lp.Character}
                    else
                        rp.FilterDescendantsInstances = {car}
                    end

                    local gRay = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), rp)
                    local targetY = gRay and (gRay.Position.Y + 4) or pos.Y
                    local yVel = math.clamp((targetY - pos.Y) * 3, -40, 30)

                    pp.AssemblyLinearVelocity = Vector3.new(straightDir.X * SPEED, yVel, straightDir.Z * SPEED)
                    return
                end
            end
        end

        applyIgnoreZombies()
        if noclipOn then applyNoclip() end
        if not driveOn then
            straightDir = nil
            return
        end

        local car = getCar()
        if not car or not car.PrimaryPart then
            straightDir = nil
            return
        end
        local pp = car.PrimaryPart
        local pos = pp.Position
        local vel = pp.AssemblyLinearVelocity
        local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
        local SPEED = customSpeed

        if not straightDir then
            local look = pp.CFrame.LookVector
            local hLook = Vector3.new(look.X, 0, look.Z)
            straightDir = hLook.Magnitude > 0.01 and hLook.Unit or Vector3.new(0, 0, -1)
        end

        pp.AssemblyAngularVelocity = Vector3.zero
        pp.CFrame = CFrame.lookAt(pos, pos + straightDir)

        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        if lp and lp.Character then
            rp.FilterDescendantsInstances = {car, lp.Character}
        else
            rp.FilterDescendantsInstances = {car}
        end

        local targetVelX = straightDir.X * SPEED
        local targetVelZ = straightDir.Z * SPEED

        local gRay = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), rp)
        local targetY = gRay and (gRay.Position.Y + 4) or pos.Y
        local yVel = math.clamp((targetY - pos.Y) * 3, -40, 30)

        pp.AssemblyLinearVelocity = Vector3.new(targetVelX, yVel, targetVelZ)
    end)
end))

