    if updateConsoleUI then pcall(updateConsoleUI) end
end

-- ===================== UTILITY FUNCTIONS =====================
local function getCar()
    local cars = workspace:FindFirstChild("Cars")
    if not cars or not lp then return nil end
    for _, c in ipairs(cars:GetChildren()) do
        if c:IsA("Model") and c:GetAttribute("OwnerUserId") == lp.UserId then return c end
    end
    return nil
end

local function myPlot()
    local g = workspace:FindFirstChild("Game")
    local plots = g and g:FindFirstChild("Lobby") and g.Lobby:FindFirstChild("Plots")
    if not plots or not lp then return nil end
    for _, p in ipairs(plots:GetChildren()) do
        if p:IsA("Model") then
            local ownerId = p:GetAttribute("OwnerUserId") or p:GetAttribute("Owner") or p:GetAttribute("UserId")
            if ownerId == lp.UserId or tostring(ownerId) == tostring(lp.UserId) then return p end
        end
    end
    for _, p in ipairs(plots:GetChildren()) do
        if p:IsA("Model") and p:FindFirstChild("Rolls") then return p end
    end
    return nil
end

local function returnToLobby()
    task.spawn(function()
        pcall(function()
            local plot = myPlot()
            if not plot then return end
            -- Find a suitable spawn position in the plot
            local targetPos = nil
            if plot.PrimaryPart then
                targetPos = plot.PrimaryPart.Position + Vector3.new(0, 5, 0)
            else
                for _, p in ipairs(plot:GetDescendants()) do
                    if p:IsA("BasePart") then
                        targetPos = p.Position + Vector3.new(0, 5, 0)
                        break
                    end
                end
            end
            if not targetPos then return end

            local car = getCar()
            if car and car.PrimaryPart then
                car.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
                car.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
                car.PrimaryPart.CFrame = CFrame.new(targetPos)
            end
            if lp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                lp.Character.HumanoidRootPart.CFrame = CFrame.new(targetPos)
            end
        end)
    end)
end

local function detectRarityInItemPlace()
    local plot = myPlot()
    if not plot then return nil, nil end
    local rolls = plot:FindFirstChild("Rolls")
    if not rolls then return nil, nil end
    for _, rollFolder in ipairs({"RollWeapons", "RollBlocks"}) do
        local rf = rolls:FindFirstChild(rollFolder)
        if rf then
            local info = rf:FindFirstChild("Info") or (rf:FindFirstChild("Roll") and rf.Roll:FindFirstChild("Info"))
            local rarityLabel = info and info:FindFirstChild("Rarity")
            if rarityLabel and rarityLabel:IsA("TextLabel") and rarityLabel.Text ~= "" and rarityLabel.Text ~= "???" then
                local txt = string.lower(rarityLabel.Text)
                for i, rName in ipairs(rarityNames) do
                    if string.find(txt, string.lower(rName)) then return i, rName end
                end
            end
            local ip = rf:FindFirstChild("ItemPlace")
            if ip then
                for _, child in ipairs(ip:GetChildren()) do
                    local itemRarity = child:GetAttribute("Rarity") or child:GetAttribute("ItemRarity")
                    if itemRarity then
                        local txt = string.lower(tostring(itemRarity))
                        for i, rName in ipairs(rarityNames) do
                            if string.find(txt, string.lower(rName)) then return i, rName end
                        end
                    end
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Text ~= "???" then
                            local txt = string.lower(desc.Text)
                            for i, rName in ipairs(rarityNames) do
                                if string.find(txt, string.lower(rName)) then return i, rName end
                            end
                        end
                    end
                end
            end
            for _, desc in ipairs(rf:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Text ~= "???" and desc.Name ~= "Chance" and desc.Name ~= "Price" and desc.Name ~= "Count" then
                    local txt = string.lower(desc.Text)
                    for i, rName in ipairs(rarityNames) do
                        if string.find(txt, string.lower(rName)) then return i, rName end
                    end
                end
            end
        end
    end
    return nil, nil
end

local function safeTween(obj, tweenInfo, props)
    if TweenService then
        pcall(function() TweenService:Create(obj, tweenInfo, props):Play() end)
    else
        pcall(function() for k, v in pairs(props) do obj[k] = v end end)
    end
end

local function safeCorner(parent, radius)
    pcall(function()
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, radius)
        c.Parent = parent
    end)
end

local function safeStroke(parent, color, thickness, transparency)
    pcall(function()
        local s = Instance.new("UIStroke")
        s.Color = color
        s.Thickness = thickness or 1
        s.Transparency = transparency or 0
        s.Parent = parent
    end)
end

